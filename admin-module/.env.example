DB_HOST=your-database-host
DB_PORT=3306
DB_NAME=ala_eh
DB_USER=your_individual_app_username
DB_PASSWORD=replace-with-your-individual-password
DB_SSL_CA="C:\path\to\database-ca.pem"

; Only an authorized schema administrator may configure these values and run migrations.
MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=

; Keep true in production; use false only for local HTTP development.
SESSION_COOKIE_SECURE=true
